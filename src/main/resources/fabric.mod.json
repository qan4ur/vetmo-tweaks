{
  "schemaVersion": 1,
  "name": "Vetmo Tweaks",
  "id": "vetmo-tweaks",
  "version": "${version}",
  "description": "Curated Meteor Client modules with a Russian interface and a red theme. Visual modules live in the separate Vetmos mod. Fork of Meteor Client by MeteorDevelopment (GPL-3.0).",
  "authors": [
    "qan4ur"
  ],
  "contact": {
    "homepage": "https://github.com/qan4ur/vetmo-tweaks",
    "issues": "https://github.com/qan4ur/vetmo-tweaks/issues",
    "sources": "https://github.com/qan4ur/vetmo-tweaks"
  },
  "license": "GPL-3.0",
  "icon": "assets/meteor-client/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "meteordevelopment.meteorclient.MeteorClient"
    ],
    "modmenu": [
      "meteordevelopment.meteorclient.ModMenuIntegration"
    ]
  },
  "mixins": [
    "meteor-client.mixins.json",
    "meteor-client-indigo.mixins.json",
    "meteor-client-sodium.mixins.json",
    "meteor-client-lithium.mixins.json",
    "meteor-client-viafabricplus.mixins.json"
  ],
  "accessWidener": "meteor-client.accesswidener",
  "custom": {
    "vetmo-tweaks:build_number": "${build_number}",
    "vetmo-tweaks:color": "200,20,40",
    "vetmo-tweaks:commit": "${commit}"
  },
  "depends": {
    "java": ">=21",
    "minecraft": ["${minecraft_version}", "1.21.6"],
    "fabricloader": ">=${loader_version}"
  },
  "breaks": {
    "optifabric": "*",
    "feather": "*",
    "origins": "*",
    "sodium": "<0.6.12",
    "morechathistory": "*"
  }
}
